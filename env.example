# Copy this file to ".env" in the same folder before running docker compose up.
# Do NOT commit the real ".env" to GitHub — add it to .gitignore.

POSTGRES_USER=fyp_user
POSTGRES_PASSWORD=fyp_pass
POSTGRES_DB=fyp_db

# Connection string your Python code will use later (Phase 1 onward)
DATABASE_URL=postgresql://fyp_user:fyp_pass@localhost:5432/fyp_db

QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
